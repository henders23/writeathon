# AI provider: set ONE of these keys. If both are set, Claude is used
# (set AI_PROVIDER=openai to force OpenAI). Keys stay on the server.

# Claude (Anthropic): create a key at https://platform.claude.com (Settings → API keys)
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown)
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_FEEDBACK_MODEL=gpt-6-luna

# Strongly recommended before sharing the link: a code students must enter,
# so strangers can't spend your API credits.
ACCESS_CODE=
