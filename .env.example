# Required: your OpenAI API key. Stays on the server; students never see it.
OPENAI_API_KEY=

# Optional: a code students must enter before they can use the AI features.
# Set this before sharing the link, so strangers can't run up your OpenAI bill.
ACCESS_CODE=

# Optional model override (default shown).
OPENAI_FEEDBACK_MODEL=gpt-6-luna
